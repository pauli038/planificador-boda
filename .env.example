# Cadena de conexión de Postgres (Neon, Supabase, etc.)
DATABASE_URL="postgresql://usuario:contraseña@host:5432/basededatos"
# Contraseña que tú y tu pareja usarán para entrar
APP_PASSWORD="elige-una-contraseña"
# Texto largo y aleatorio para firmar la sesión (ej. salida de: openssl rand -hex 32)
AUTH_SECRET="cambia-esto-por-un-texto-largo-aleatorio"
